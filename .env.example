# Copy to .env and fill this value through a private local secret manager.
# Never commit .env or paste the token into chat.

# Existing Hermes Gateway / voice service configuration.
DISCORD_BOT_TOKEN=
OPENAI_API_KEY=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Optional: process only this Discord user's voice
DISCORD_ALLOWED_USER_ID=

# Technical worker/auditor credentials. These are not injected into the
# separate Codex Discord bot.
CODEX_WORKER_TOKEN=

# Dedicated credential for the isolated read-only Chat Worker and its Bot.
# Keep this different from CODEX_WORKER_TOKEN.
CODEX_CHAT_WORKER_TOKEN=
CODEX_CHAT_WORKER_URL=http://127.0.0.1:8777

# Dedicated Discord application for the Codex bot. Keep this different from
# DISCORD_BOT_TOKEN.
CODEX_DISCORD_BOT_TOKEN=
CODEX_DISCORD_GUILD_ID=
CODEX_DISCORD_TEXT_CHANNEL_ID=
CODEX_DISCORD_VOICE_CHANNEL_ID=
CODEX_DISCORD_ALLOWED_USER_ID=
CODEX_CHAT_WORKER_TIMEOUT=90
CODEX_STT_MODEL=gpt-4o-mini-transcribe
CODEX_TTS_MODEL=gpt-4o-mini-tts
CODEX_TTS_VOICE=alloy

# Local PC Codex JUNMAI bot.  The local entry point starts its own prompt-only
# read-only Chat Worker on loopback; it does not load Hermes credentials.
CODEX_CHAT_WORKDIR=C:/AI/APP/hermes-voice-suite
CODEX_CHAT_HOST=127.0.0.1
CODEX_CHAT_PORT=8777

# Local Codex worker (8765 is reserved for the Whisper CUDA service).
CODEX_LOCAL_WORKER_HOST=127.0.0.1
CODEX_LOCAL_WORKER_PORT=8767
CODEX_LOCAL_WORKER_ID=local-codex-burst-1
CODEX_LOCAL_WORKER_RETRY_SECONDS=30

# VPS reverse tunnel target. The reverse bind stays on VPS loopback.
CODEX_SSH_CONFIG=C:/AI/APP/hermes-voice-suite/codex-ssh-config
CODEX_SSH_TARGET=hub-vps
CODEX_REMOTE_WORKER_PORT=8767
CODEX_TUNNEL_RETRY_SECONDS=60
