# Copy this file to .env locally. Never commit the copy.
DISCORD_BOT_TOKEN=
OPENAI_API_KEY=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Optional: process only this Discord user's voice
DISCORD_ALLOWED_USER_ID=

# Technical task ledger and Codex worker routing. Keep tokens out of files.
VOICE_TECH_LEDGER_PATH=
CODEX_COMMAND=codex
CODEX_SANDBOX=workspace-write
CODEX_REPO_PATH=
CODEX_WORKER_TOKEN=
CODEX_WORKER_HOST=127.0.0.1
CODEX_WORKER_PORT=8765
# On Hermes/VPS: URL of the local-PC worker when it is online.
CODEX_LOCAL_WORKER_URL=
# Separate VPS audit worker URL. Required when CODEX_VPS_WORKER_URL is remote.
CODEX_AUDITOR_URL=
# Optional URL for a VPS implementation worker. If empty, run Codex locally on this host.
CODEX_VPS_WORKER_URL=
