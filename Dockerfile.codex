FROM node:22-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CODEX_HOME=/codex-home \
    CODEX_CHAT_HOME=/codex-chat-home \
    CODEX_REPO_PATH=/workspace \
    PATH=/opt/venv/bin:${PATH}

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        bubblewrap \
        git \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src ./src

RUN /opt/venv/bin/python -m pip install --upgrade pip \
    && /opt/venv/bin/python -m pip install . \
    && npm install --global @openai/codex

RUN useradd --create-home --uid 10002 --shell /bin/bash codex \
    && mkdir --parents /codex-home /codex-chat-home /workspace \
    && chown --recursive codex:codex /codex-home /codex-chat-home /workspace \
    && git config --system --add safe.directory /workspace

USER codex

ENTRYPOINT ["voice-suite", "tech", "worker"]
